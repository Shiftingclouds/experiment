{
  "name": "heldwater",
  "productName": "Heldwater",
  "version": "1.0.0",
  "description": "Heldwater \u2014 an interactive novel",
  "author": "shiftingclouds",
  "main": "main.js",
  "scripts": {
    "sync": "node ../tools/build.js && node -e \"require('fs').copyFileSync('../dist/heldwater.html','app/heldwater.html')\"",
    "start": "npm run sync && electron .",
    "dist:win": "npm run sync && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.shiftingclouds.heldwater",
    "productName": "Heldwater",
    "files": [
      "main.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Heldwater.exe"
    },
    "afterPack": "./afterPack.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pe-library": "^2.0.1",
    "resedit": "^3.1.0"
  }
}