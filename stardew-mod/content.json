{
  "Format": "2.0.0",
  "Changes": [
    // ---------------------------------------------------------------- art
    {
      "Action": "Load",
      "Target": "Characters/{{ModId}}_Auden",
      "FromFile": "assets/Auden/Auden_sprite.png"
    },
    {
      // vanilla 64x64 portraits (fallback when no HD portrait framework is installed)
      "Action": "Load",
      "Target": "Portraits/{{ModId}}_Auden",
      "FromFile": "assets/Auden/Auden_portraits.png"
    },
    {
      // 128x128 portraits, same layout your existing characters use
      "Action": "Load",
      "Target": "Mods/{{ModId}}/Portraits/Auden_HD",
      "FromFile": "assets/Auden/Auden_portraits_HD.png"
    },
    {
      // HD Portraits metadata. If your other characters use a different HD framework, copy their setup here instead.
      "Action": "EditData",
      "Target": "Mods/HDPortraits",
      "Entries": {
        "{{ModId}}_Auden": {
          "Size": 128,
          "Portrait": "Mods/{{ModId}}/Portraits/Auden_HD"
        }
      },
      "When": { "HasMod": "tlitookilakin.HDPortraits" }
    },

    // ---------------------------------------------------------------- NPC data
    {
      "Action": "EditData",
      "Target": "Data/Characters",
      "Entries": {
