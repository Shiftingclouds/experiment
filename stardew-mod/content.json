          "SocialAnxiety": "Neutral",
          "Optimism": "Positive",
          "IsDarkSkinned": true,
          "CanBeRomanced": true,
          "BirthSeason": "Winter",
          "BirthDay": 11,
          "HomeRegion": "Town",
          "Home": [
            {
              // TODO: point this at the school's observatory map once it exists.
